FROM ruby:3.4.13-slim@sha256:f038b6952ce49d4d7bcbe2a6c194299f5c70b45fc6d9f9fec4798c4c0f61aed3

LABEL com.salary-mgmt="true"

RUN apt-get update \
  && apt-get install --no-install-recommends -y build-essential libyaml-dev sqlite3 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000", "-P", "/tmp/server.pid"]
